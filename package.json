{
  "name": "recur",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "pnpm --filter @recur/web build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check apps packages scripts tests *.json *.ts *.yaml docs README.md",
    "test": "vitest run",
    "test:integration": "vitest run apps/demo-service/tests",
    "db:migrate": "node --import tsx scripts/setup-demo.ts",
    "demo:seed": "node --import tsx scripts/seed-incident.ts",
    "demo:reset": "node --import tsx scripts/reset-demo.ts",
    "demo:seed:arga": "node --import tsx scripts/seed-arga-stripe.ts",
    "evals": "node --import tsx scripts/run-evals.ts",
    "capsule:replay": "node --import tsx scripts/replay-capsule.ts",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.yaml docs README.md",
    "worker": "node --import tsx scripts/worker.ts",
    "start": "RECUR_PRODUCTION=true node --import tsx scripts/dev.ts",
    "arga:provision": "node --import tsx scripts/arga.ts provision",
    "arga:status": "node --import tsx scripts/arga.ts status",
    "arga:teardown": "node --import tsx scripts/arga.ts teardown",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm evals && pnpm evals:stress && pnpm test:restart && pnpm build",
    "test:e2e": "playwright test",
    "evals:stress": "node --import tsx scripts/stress-evals.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "test:live": "node --import tsx scripts/live-acceptance.ts",
    "test:restart": "node --import tsx scripts/verify-restart.ts"
  },
  "dependencies": {
    "@launchdarkly/node-server-sdk": "9.13.4",
    "@libsql/client": "0.18.0",
    "@openai/agents": "0.18.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@uselemma/tracing": "7.12.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "stripe": "22.6.2",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
