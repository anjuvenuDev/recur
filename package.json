{
  "name": "recur",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm --filter @recur/web build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check apps packages scripts *.json *.ts *.yaml docs README.md",
    "test": "vitest run",
    "test:integration": "vitest run apps/demo-service/tests",
    "db:migrate": "tsx scripts/setup-demo.ts",
    "demo:seed": "tsx scripts/seed-incident.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "demo:seed:arga": "tsx scripts/seed-arga-stripe.ts",
    "evals": "tsx scripts/run-evals.ts",
    "capsule:replay": "tsx scripts/replay-capsule.ts",
    "format": "prettier --write apps packages scripts *.json *.ts *.yaml docs README.md"
  },
  "dependencies": {
    "@launchdarkly/node-server-sdk": "latest",
    "@libsql/client": "latest",
    "@openai/agents": "latest",
    "@opentelemetry/api": "latest",
    "@opentelemetry/instrumentation-express": "latest",
    "@opentelemetry/instrumentation-http": "latest",
    "@opentelemetry/resources": "latest",
    "@opentelemetry/sdk-node": "latest",
    "@opentelemetry/sdk-trace-base": "latest",
    "@opentelemetry/semantic-conventions": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "express": "^5.1.0",
    "stripe": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.6",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  }
}
